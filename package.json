{
	"name": "switchyard",
	"version": "0.1.0",
	"type": "module",
	"license": "MIT",
	"private": true,
	"scripts": {
		"prepare": "husky",
		"test": "node scripts/run-test-phases.mjs",
		"test:serial": "node --test --test-concurrency=1 tests/dispatch-cli.test.mjs tests/detached-dispatch.test.mjs tests/no-host-rights-vm.test.mjs tests/workspace-wipe-vm.test.mjs",
		"test:other": "files=\"\"; for f in tests/*.test.mjs; do case \"$f\" in tests/dispatch-cli.test.mjs|tests/detached-dispatch.test.mjs|tests/no-host-rights-vm.test.mjs|tests/workspace-wipe-vm.test.mjs) ;; *) files=\"$files $f\";; esac; done; node --test $files",
		"lint": "biome check .",
		"deadcode": "knip",
		"roster:coherence": "node src/switchyard/roster/index.mjs --coherence",
		"validate": "node scripts/run-validate-phases.mjs",
		"auth": "node src/switchyard/auth/index.mjs",
		"auth:check": "node src/switchyard/auth/index.mjs --check",
		"auth:check:live": "node src/switchyard/auth/index.mjs --check --live",
		"dispatch": "node src/switchyard/dispatch/index.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"husky": "^9.1.7",
		"knip": "^6.24.0"
	}
}
