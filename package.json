{
	"name": "switchyard",
	"version": "0.3.0",
	"type": "module",
	"bin": {
		"switchyard-dispatch": "src/switchyard/dispatch/index.mjs"
	},
	"license": "MIT",
	"private": true,
	"scripts": {
		"prepare": "git config core.hooksPath .githooks",
		"test": "node scripts/run-test-phases.mjs",
		"test:serial": "node scripts/test-manifest.mjs --run serial",
		"test:other": "node scripts/test-manifest.mjs --run other",
		"test:properties": "node scripts/run-test-phases.mjs --properties",
		"test:contracts": "node scripts/check-contract-gates.mjs --run && node scripts/run-contract-coverage.mjs",
		"test:coverage": "node scripts/run-contract-coverage.mjs",
		"test:mutation:contracts": "node scripts/run-incident-mutations.mjs",
		"lint": "biome check .",
		"deadcode": "knip",
		"check:size": "node scripts/check-file-size.mjs --all",
		"roster:coherence": "node src/switchyard/roster/index.mjs --coherence",
		"validate": "node scripts/run-validate-phases.mjs",
		"validate:host": "node scripts/run-host-validation.mjs",
		"canary:sandbox": "node scripts/sandbox-canary.mjs",
		"canary:install": "ops/install-sandbox-canary.sh",
		"canary:uninstall": "ops/uninstall-sandbox-canary.sh",
		"sweep:temp": "node scripts/sweep-temp-dirs.mjs",
		"cli:canary": "node scripts/cli-canary.mjs",
		"cli:check": "ops/macos-vm/sync-host-clis.sh --cli-manifest ops/macos-vm/cli-manifest.txt --check",
		"cli:sync": "ops/macos-vm/sync-host-clis.sh --cli-manifest ops/macos-vm/cli-manifest.txt",
		"dispatch": "node src/switchyard/dispatch/index.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"fast-check": "^4.9.0",
		"knip": "^6.24.0"
	}
}
